# Copy sang apps/api/.env truoc khi chay dev.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cms_starter?schema=public"
PORT=4000

# Secret ky VA verify token dang nhap. Doi gia tri nay -> moi token dang luu hanh
# thanh 401 {"error":"Invalid token"} (user phai dang nhap lai).
JWT_SECRET="doi-chuoi-nay-thanh-random-that-khi-deploy"

# Redis: cache auth (JwtAuthGuard) + queue BullMQ. Redis chet -> auth van chay
# (rot ve DB) va POST /users van tao user, chi la job khong duoc enqueue.
REDIS_URL="redis://localhost:6379"
